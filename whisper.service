[Unit]
Description=Whisper API Service
After=network.target
Wants=network.target

[Service]
Type=simple
# Dedicated unprivileged user, see "Install" in the README.
User=whisper-api
Group=whisper-api
WorkingDirectory=/opt/whisper-api
Environment=PATH=/opt/ai-env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WHISPER_MODEL=base
# Hugging Face model cache, in /var/cache/whisper-api (created by systemd, owned by the user).
CacheDirectory=whisper-api
Environment=HF_HOME=/var/cache/whisper-api
# Secret WHISPER_API_KEY lives in /opt/whisper-api/.env (git-ignored); the leading
# dash makes the file optional so the unit still starts if it is absent. systemd
# reads it as root, so it can stay root-only (chmod 600).
EnvironmentFile=-/opt/whisper-api/.env
ExecStart=/opt/ai-env/bin/gunicorn -c /opt/whisper-api/gunicorn.conf.py whisper-api:app
Restart=always
RestartSec=10
NoNewPrivileges=yes
# Peak about 0.6 GB with WHISPER_MODEL=base and one transcription at a time
# (README, "Memory"). small peaks at about 1.4 GB: raise this to 2G for it, more
# for medium or large-v3 or WHISPER_NUM_WORKERS above 1. Past the limit the
# kernel stops the service and systemd restarts it.
MemoryMax=1G
# Extra sandboxing; needs mount namespaces, which an unprivileged LXC container
# may not allow (the unit then fails with status 226/NAMESPACE).
#PrivateTmp=yes
#ProtectSystem=strict
#ProtectHome=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
